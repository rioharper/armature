# The eval scaffolds run under bash in WSL, which reads a CRLF as part of the
# command; keep them LF whatever core.autocrlf says.
evals/**/*.sh text eol=lf
# An unstated red-team variant's implicit.patch is applied over its case's
# planted/ by `git apply`, which matches line endings exactly: both stay LF.
evals/*/planted/** text eol=lf
evals/**/*.patch text eol=lf
# The hold-out is frozen by a hash over its text (evals/tests/test_holdout.py),
# which reads it with LF line endings; keep it LF on disk too.
evals/holdout/** text eol=lf
# Plugin scripts run under bash, on Windows and Linux alike.
scripts/*.sh text eol=lf
